# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database (PGlite)
/.data

# 평가 실행 결과(학생 데이터 아님, 필요하면 커밋)
/evals/result-*.json

# 내장 모델 파일(수백 MB, scripts/fetch-model.mjs로 받음)
/public/models/
/public/ort/

# Python
__pycache__/
*.pyc

# 아동 음성 인식 학습 도구(training/asr): 데이터·가짜 데이터 산출물은 절대 커밋하지 않는다(AI Hub 약관)
training/asr/work/
training/asr/data/
training/asr/**/*.wav
training/asr/**/*.npy
training/asr/**/*.zip
training/asr/**/*.zip.part*
*.zip.part*
