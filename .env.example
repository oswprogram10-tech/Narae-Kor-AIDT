# 세션 쿠키 서명 키(필수, 운영 환경). 예: openssl rand -hex 32
SESSION_SECRET=

# ── 코치 AI(모두 선택 사항, 서버에만 둡니다) ──
# 키가 없는 AI는 건너뛰고, 아무것도 없으면 '모의 코치'(정해진 질문 은행)로 동작합니다.
# Claude (모델 기본값: 가장 저렴한 claude-haiku-5-5)
ANTHROPIC_API_KEY=
# NARAE_CLAUDE_MODEL=claude-haiku-5-5
# NARAE_COACH_EFFORT=low

# Gemini (모델 이름은 Google AI 문서의 현재 모델 이름을 넣으세요. 이름이 없으면 사용 안 함)
GEMINI_API_KEY=
NARAE_GEMINI_MODEL=

# ChatGPT / OpenAI (모델 이름은 OpenAI 문서의 현재 모델 이름을 넣으세요. 이름이 없으면 사용 안 함)
OPENAI_API_KEY=
NARAE_OPENAI_MODEL=
# NARAE_OPENAI_BASE_URL=https://api.openai.com/v1

# 내장 AI(학생 기기 안에서 실행). 모델 파일은 npm run model:fetch -- narae-coach-1b 로 public/models 에 받습니다.
# NARAE_LOCAL_MODEL=narae-coach-1b      # narae-coach-1b(권장, 안전 파인튜닝) | gemma-3-1b(원본) | qwen2.5-0.5b | qwen3-0.6b
# NARAE_LOCAL_MODEL_BASE_URL=/models/
# NARAE_LOCAL_MODEL_REMOTE=1            # 파일이 없으면 Hugging Face에서 받기(실험용)

# 기본 시도 순서(쉼표로 구분). 과제마다 교사가 따로 고를 수도 있습니다.
# NARAE_PROVIDER_ORDER=local,claude,gemini,openai

# 학생 1명당 하루 코치 사용 횟수 상한(비용 관리)
# NARAE_COACH_DAILY_LIMIT=30

# 강제로 모의 코치를 쓰려면 mock
# NARAE_COACH_MODE=mock

# PostgreSQL 연결 문자열(예: Supabase). 비워 두면 ./.data/pglite 에 내장 DB로 저장합니다.
# 배포(Vercel 등)에서는 반드시 설정해야 합니다.
DATABASE_URL=
