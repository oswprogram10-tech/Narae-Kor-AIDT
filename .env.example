# 세션 쿠키 서명 키(필수, 운영 환경). 예: openssl rand -hex 32
SESSION_SECRET=

# Claude API 키. 비워 두면 '모의 코치'(정해진 질문 은행)로 동작합니다.
ANTHROPIC_API_KEY=

# 코치 모델과 사고 강도(기본: 가장 저렴한 claude-haiku-5-5, low)
# NARAE_COACH_MODEL=claude-haiku-5-5
# NARAE_COACH_EFFORT=low

# 학생 1명당 하루 코치 사용 횟수 상한(비용 관리)
# NARAE_COACH_DAILY_LIMIT=30

# 강제로 모의 코치를 쓰려면 mock
# NARAE_COACH_MODE=mock

# PostgreSQL 연결 문자열(예: Supabase). 비워 두면 ./.data/pglite 에 내장 DB로 저장합니다.
# 배포(Vercel 등)에서는 반드시 설정해야 합니다.
DATABASE_URL=
