{
  "_설명": "AI Hub 「한국어 아동 음성 데이터」 라벨 JSON의 칸 이름을 적어 두는 설정이에요. 실제 JSON의 키가 다르면 이 파일(또는 --fields 로 준 다른 파일)에서 고치세요. 경로는 점(.)으로 잇고, 대소문자·밑줄·하이픈은 무시해요. 목록이면 앞에서부터 찾아요. 경로로 못 찾으면 마지막 이름만으로도 한 번 더 찾아요.",
  "paths": {
    "transcript": ["Transcription.LableText", "Transcription.LabelText", "Transcription.Text"],
    "data_category": ["Basic.DataCategory"],
    "school_year": ["Speaker.SchoolYear"],
    "age": ["Speaker.Age"],
    "age_group": ["Speaker.AgeGroup"],
    "gender": ["Speaker.Gender"],
    "noise": ["Environment.NoiseEnviron"],
    "recording_env": ["Environment.RecordingEnviron"],
    "sampling_rate": ["Wav.SamplingRate"],
    "file_name": ["File.FileName"],
    "file_length": ["File.FileLength"],
    "speech_start": ["Miscellaneous_Info.SpeechStart"],
    "speech_end": ["Miscellaneous_Info.SpeechEnd"]
  },
  "sensitive_keys": ["SpeakerName", "Name", "Region", "Dialect", "이름", "화자이름", "지역", "방언", "Address", "Phone", "Email", "BirthDate"],
  "categorical_keys": ["DataCategory", "SchoolYear", "Age", "AgeGroup", "NoiseEnviron", "RecordingEnviron", "Gender", "SamplingRate"],
  "values": {
    "formal": ["정형", "Formatted"],
    "informal": ["비정형", "Unformatted", "UnFormatted", "Unformated"],
    "noise_clean": ["무소음", "조용", "정숙", "quiet", "silent", "silence", "clean", "없음", "none"],
    "noise_noisy": ["소음", "시끄", "noisy", "noise", "잡음"],
    "school_year_map": {"Y0": "미취학", "Y1": "초1", "Y2": "초2", "Y3": "초3", "Y4": "초4", "Y5": "초5", "Y6": "초6"}
  },
  "speaker": {
    "_설명": "화자 코드를 파일 이름(확장자 뺀 것)에서 뽑는 정규식이에요. 첫 번째 묶음(...)이 화자 코드예요. 이름은 쓰지 않아요.",
    "regex": "(?:^|[_\\-])([A-Za-z]{0,4}\\d{3,8})(?=[_\\-.]|$)",
    "source": "name"
  },
  "zip_pairs": [
    {"label": "^TL_", "source": "TS_"},
    {"label": "^VL_", "source": "VS_"}
  ],
  "validation_markers": ["VL_", "Validation", "검증"],
  "normalize": {
    "_설명": "전사 기호 처리 규칙이에요. dual_keep: (철자)/(발음) 중 남길 쪽(first=철자, second=발음).",
    "dual_keep": "first",
    "noise_tag_regex": "(?<![0-9A-Za-z가-힣])[A-Za-z]/",
    "unclear_marks": ["*"],
    "unclear_policy": "drop",
    "remove_chars": "+",
    "unwrap_brackets": "()[]{}<>",
    "strip_punctuation": true,
    "drop_if_regex": []
  }
}
